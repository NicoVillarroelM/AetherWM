<Window x:Class="AetherWM.Widgets.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AetherWM Desktop Widget"
        Width="340" Height="240"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="False"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">

    <Window.Resources>
        <!-- Custom Modern Progress Bar Style -->
        <Style x:Key="NeonProgressBarStyle" TargetType="ProgressBar">
            <Setter Property="Height" Value="6" />
            <Setter Property="Background" Value="#252A34" />
            <Setter Property="Foreground" Value="#00F0FF" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid>
                            <Border Background="{TemplateBinding Background}" CornerRadius="3" />
                            <Border x:Name="PART_Indicator" 
                                    Background="{TemplateBinding Foreground}" 
                                    HorizontalAlignment="Left" 
                                    CornerRadius="3" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Margin="10" 
            Background="#D9161922" 
            BorderBrush="#3300F0FF" 
            BorderThickness="1" 
            CornerRadius="16">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" ShadowDepth="4" Opacity="0.5" Color="#000000" />
        </Border.Effect>

        <Grid Margin="18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="12" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Big Modern Clock -->
            <TextBlock x:Name="ClockText" 
                       Grid.Row="0" 
                       Text="00:00" 
                       FontSize="46" 
                       FontWeight="Bold" 
                       Foreground="#FFFFFF" 
                       FontFamily="Segoe UI Variable Display, Segoe UI, sans-serif"
                       VerticalAlignment="Center" />

            <!-- Date -->
            <TextBlock x:Name="DateText" 
                       Grid.Row="1" 
                       Text="JUEVES, 22 DE OCTUBRE" 
                       FontSize="11" 
                       FontWeight="SemiBold" 
                       Foreground="#00F0FF" 
                       Margin="2, -2, 0, 0" />

            <!-- Hardware Monitors -->
            <!-- CPU Row -->
            <StackPanel Grid.Row="3" Margin="0, 8, 0, 8">
                <Grid Margin="0, 0, 0, 4">
                    <TextBlock Text="CPU" FontSize="11" FontWeight="Bold" Foreground="#8892B0" />
                    <TextBlock x:Name="CpuText" Text="0%" FontSize="11" FontWeight="Bold" Foreground="#CCD6F6" HorizontalAlignment="Right" />
                </Grid>
                <ProgressBar x:Name="CpuBar" Style="{StaticResource NeonProgressBarStyle}" Value="0" Foreground="#00F0FF" />
            </StackPanel>

            <!-- RAM Row -->
            <StackPanel Grid.Row="4">
                <Grid Margin="0, 0, 0, 4">
                    <TextBlock Text="MEMORIA RAM" FontSize="11" FontWeight="Bold" Foreground="#8892B0" />
                    <TextBlock x:Name="RamText" Text="0 GB (0%)" FontSize="11" FontWeight="Bold" Foreground="#CCD6F6" HorizontalAlignment="Right" />
                </Grid>
                <ProgressBar x:Name="RamBar" Style="{StaticResource NeonProgressBarStyle}" Value="0" Foreground="#BD93F9" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
