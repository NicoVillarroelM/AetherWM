<Window x:Class="AetherWM.Settings.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AetherWM - Panel de Control"
        Width="880" Height="600"
        MinWidth="800" MinHeight="500"
        WindowStartupLocation="CenterScreen"
        Background="#111319"
        Foreground="#ECEFF4"
        FontFamily="Segoe UI Variable Display, Segoe UI, sans-serif">

    <Window.Resources>
        <!-- Modern Button Style -->
        <Style x:Key="AccentButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#00F0FF" />
            <Setter Property="Foreground" Value="#0A0E17" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="18, 8" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#33F3FF" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SidebarButtonStyle" TargetType="RadioButton">
            <Setter Property="Foreground" Value="#8F9BA8" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Padding" Value="14, 10" />
            <Setter Property="Margin" Value="0, 2" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1A1F2C" />
                                <Setter Property="Foreground" Value="#ECEFF4" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#222838" />
                                <Setter Property="Foreground" Value="#00F0FF" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern Slider Style -->
        <Style TargetType="Slider">
            <Setter Property="Foreground" Value="#00F0FF" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- LEFT SIDEBAR -->
        <Border Grid.Column="0" Background="#161922" BorderBrush="#222838" BorderThickness="0, 0, 1, 0">
            <Grid Margin="18">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Brand Header -->
                <StackPanel Grid.Row="0" Margin="0, 4, 0, 24">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="⚡" FontSize="20" Margin="0, 0, 8, 0" VerticalAlignment="Center" />
                        <TextBlock Text="AETHER WM" FontSize="18" FontWeight="Bold" Foreground="#FFFFFF" />
                    </StackPanel>
                    <TextBlock Text="Suite de Personalización v0.4" FontSize="11" Foreground="#6C7A89" Margin="28, 2, 0, 0" />
                </StackPanel>

                <!-- Navigation Tabs -->
                <StackPanel Grid.Row="1">
                    <RadioButton x:Name="TabMosaico" Style="{StaticResource SidebarButtonStyle}" Content="📐  Mosaico &amp; Márgenes" IsChecked="True" Checked="Tab_Checked" />
                    <RadioButton x:Name="TabEstilo" Style="{StaticResource SidebarButtonStyle}" Content="🎨  Estilos &amp; Bordes" Checked="Tab_Checked" />
                    <RadioButton x:Name="TabAtajos" Style="{StaticResource SidebarButtonStyle}" Content="⌨️  Guía de Atajos" Checked="Tab_Checked" />
                    <RadioButton x:Name="TabWidgets" Style="{StaticResource SidebarButtonStyle}" Content="🕒  Widgets de Escritorio" Checked="Tab_Checked" />
                </StackPanel>

                <!-- Bottom Status -->
                <StackPanel Grid.Row="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="8" Height="8" Fill="#50FA7B" Margin="0, 0, 8, 0" />
                    <TextBlock Text="Dotfiles sincronizados" FontSize="11" Foreground="#8F9BA8" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- RIGHT CONTENT AREA -->
        <Grid Grid.Column="1" Margin="28, 24, 28, 20">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- TAB 1: MOSAICO & MÁRGENES -->
            <ScrollViewer x:Name="PanelMosaico" Grid.Row="0" VerticalScrollBarVisibility="Auto" Visibility="Visible">
                <StackPanel>
                    <TextBlock Text="Configuración de Mosaico (Tiling)" FontSize="20" FontWeight="Bold" Foreground="#FFFFFF" Margin="0, 0, 0, 4" />
                    <TextBlock Text="Ajusta el espaciado geométrico entre ventanas y los bordes de la pantalla." FontSize="13" Foreground="#8F9BA8" Margin="0, 0, 0, 20" />

                    <!-- Card: Gaps -->
                    <Border Background="#181C26" CornerRadius="12" Padding="18" Margin="0, 0, 0, 16" BorderBrush="#252A38" BorderThickness="1">
                        <StackPanel>
                            <!-- Inner Gap Slider -->
                            <Grid Margin="0, 0, 0, 8">
                                <TextBlock Text="Margen Interior (Entre Ventanas)" FontWeight="SemiBold" FontSize="14" Foreground="#ECEFF4" />
                                <TextBlock x:Name="LblInnerGap" Text="10 px" FontWeight="Bold" FontSize="14" Foreground="#00F0FF" HorizontalAlignment="Right" />
                            </Grid>
                            <Slider x:Name="SliderInnerGap" Minimum="0" Maximum="40" Value="10" SmallChange="1" LargeChange="5" ValueChanged="SliderInnerGap_ValueChanged" Margin="0, 0, 0, 18" />

                            <!-- Outer Gap Slider -->
                            <Grid Margin="0, 0, 0, 8">
                                <TextBlock Text="Margen Exterior (Borde de Pantalla)" FontWeight="SemiBold" FontSize="14" Foreground="#ECEFF4" />
                                <TextBlock x:Name="LblOuterGap" Text="12 px" FontWeight="Bold" FontSize="14" Foreground="#00F0FF" HorizontalAlignment="Right" />
                            </Grid>
                            <Slider x:Name="SliderOuterGap" Minimum="0" Maximum="50" Value="12" SmallChange="1" LargeChange="5" ValueChanged="SliderOuterGap_ValueChanged" />
                        </StackPanel>
                    </Border>

                    <!-- Card: Options -->
                    <Border Background="#181C26" CornerRadius="12" Padding="18" BorderBrush="#252A38" BorderThickness="1">
                        <StackPanel>
                            <CheckBox x:Name="ChkAutoTile" Content="Organizar automáticamente en mosaico al iniciar (AutoTile)" FontSize="14" Foreground="#ECEFF4" IsChecked="True" />
                            <TextBlock Text="Si está activado, AetherWM posicionará las ventanas abiertas al arrancar el servicio." FontSize="12" Foreground="#6C7A89" Margin="24, 4, 0, 0" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- TAB 2: ESTILOS & BORDES -->
            <ScrollViewer x:Name="PanelEstilo" Grid.Row="0" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                <StackPanel>
                    <TextBlock Text="Estética Visual de Ventanas (DWM)" FontSize="20" FontWeight="Bold" Foreground="#FFFFFF" Margin="0, 0, 0, 4" />
                    <TextBlock Text="Personaliza los bordes de color dinámicos de Windows 11 al estilo Hyprland." FontSize="13" Foreground="#8F9BA8" Margin="0, 0, 0, 20" />

                    <!-- Card: Border Styling -->
                    <Border Background="#181C26" CornerRadius="12" Padding="18" Margin="0, 0, 0, 16" BorderBrush="#252A38" BorderThickness="1">
                        <StackPanel>
                            <CheckBox x:Name="ChkEnableBorders" Content="Activar bordes de color dinámicos en ventanas" FontSize="14" Foreground="#ECEFF4" IsChecked="True" Margin="0, 0, 0, 16" />

                            <TextBlock Text="Color de Ventana Activa (En Foco):" FontWeight="SemiBold" FontSize="13" Foreground="#8F9BA8" Margin="0, 0, 0, 8" />
                            <StackPanel Orientation="Horizontal" Margin="0, 0, 0, 16">
                                <Border x:Name="ColorPreviewBox" Width="36" Height="36" CornerRadius="8" Background="#00F0FF" Margin="0, 0, 12, 0" BorderBrush="#FFFFFF" BorderThickness="1" />
                                <TextBox x:Name="TxtActiveColor" Text="#00F0FF" Width="100" Height="36" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Background="#111319" Foreground="#FFFFFF" BorderBrush="#252A38" TextChanged="TxtActiveColor_TextChanged" Margin="0, 0, 14, 0" />

                                <!-- Presets -->
                                <Button Content="Cian" Tag="#00F0FF" Click="PresetColor_Click" Margin="0, 0, 6, 0" Background="#1A202C" Foreground="#00F0FF" BorderThickness="0" Padding="10, 6" Cursor="Hand" />
                                <Button Content="Morado" Tag="#BD93F9" Click="PresetColor_Click" Margin="0, 0, 6, 0" Background="#1A202C" Foreground="#BD93F9" BorderThickness="0" Padding="10, 6" Cursor="Hand" />
                                <Button Content="Verde" Tag="#50FA7B" Click="PresetColor_Click" Margin="0, 0, 6, 0" Background="#1A202C" Foreground="#50FA7B" BorderThickness="0" Padding="10, 6" Cursor="Hand" />
                                <Button Content="Rojo" Tag="#FF5555" Click="PresetColor_Click" Margin="0, 0, 6, 0" Background="#1A202C" Foreground="#FF5555" BorderThickness="0" Padding="10, 6" Cursor="Hand" />
                                <Button Content="Oro" Tag="#F1FA8C" Click="PresetColor_Click" Background="#1A202C" Foreground="#F1FA8C" BorderThickness="0" Padding="10, 6" Cursor="Hand" />
                            </StackPanel>

                            <TextBlock Text="Color de Ventanas Inactivas:" FontWeight="SemiBold" FontSize="13" Foreground="#8F9BA8" Margin="0, 0, 0, 8" />
                            <StackPanel Orientation="Horizontal">
                                <Border x:Name="InactiveColorPreviewBox" Width="36" Height="36" CornerRadius="8" Background="#2E3440" Margin="0, 0, 12, 0" BorderBrush="#FFFFFF" BorderThickness="1" />
                                <TextBox x:Name="TxtInactiveColor" Text="#2E3440" Width="100" Height="36" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Background="#111319" Foreground="#FFFFFF" BorderBrush="#252A38" TextChanged="TxtInactiveColor_TextChanged" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Card: Corners -->
                    <Border Background="#181C26" CornerRadius="12" Padding="18" BorderBrush="#252A38" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="Estilo de Esquinas de las Ventanas" FontWeight="SemiBold" FontSize="14" Foreground="#ECEFF4" Margin="0, 0, 0, 10" />
                            <RadioButton x:Name="RadioSquare" GroupName="Corners" Content="⏹️  Esquinas Rectas / Cuadradas (Estilo Linux bspwm/Hyprland)" FontSize="13" Foreground="#ECEFF4" Margin="0, 0, 0, 8" IsChecked="True" />
                            <RadioButton x:Name="RadioRounded" GroupName="Corners" Content="🔄  Esquinas Redondeadas (Estilo Windows 11)" FontSize="13" Foreground="#ECEFF4" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- TAB 3: GUÍA DE ATAJOS -->
            <ScrollViewer x:Name="PanelAtajos" Grid.Row="0" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                <StackPanel>
                    <TextBlock Text="Guía Rápida de Atajos de Teclado" FontSize="20" FontWeight="Bold" Foreground="#FFFFFF" Margin="0, 0, 0, 4" />
                    <TextBlock Text="Atajos globales activos para controlar el escritorio sin usar el ratón." FontSize="13" Foreground="#8F9BA8" Margin="0, 0, 0, 20" />

                    <!-- Cheatsheet List -->
                    <Border Background="#181C26" CornerRadius="12" Padding="14" BorderBrush="#252A38" BorderThickness="1">
                        <StackPanel>
                            <!-- Item 1 -->
                            <Grid Margin="0, 6, 0, 10">
                                <StackPanel Orientation="Horizontal">
                                    <Border Background="#252C3D" CornerRadius="6" Padding="8, 4" Margin="0, 0, 4, 0"><TextBlock Text="Alt" FontWeight="Bold" FontSize="11" Foreground="#00F0FF" /></Border>
                                    <TextBlock Text="+" Foreground="#8F9BA8" Margin="2, 4, 6, 0" />
                                    <Border Background="#252C3D" CornerRadius="6" Padding="8, 4" Margin="0, 0, 4, 0"><TextBlock Text="Shift" FontWeight="Bold" FontSize="11" Foreground="#00F0FF" /></Border>
                                    <TextBlock Text="+" Foreground="#8F9BA8" Margin="2, 4, 6, 0" />
                                    <Border Background="#252C3D" CornerRadius="6" Padding="8, 4"><TextBlock Text="Enter" FontWeight="Bold" FontSize="11" Foreground="#00F0FF" /></Border>
                                </StackPanel>
                                <TextBlock Text="Abrir Terminal configurada (Windows Terminal / PowerShell)" FontSize="13" Foreground="#ECEFF4" HorizontalAlignment="Right" VerticalAlignment="Center" />
                            </Grid>
                            <Separator Background="#222838" Margin="0, 4" />

                            <!-- Item 2 -->
                            <Grid Margin="0, 6, 0, 10">
                                <StackPanel Orientation="Horizontal">
                                    <Border Background="#252C3D" CornerRadius="6" Padding="8, 4" Margin="0, 0, 4, 0"><TextBlock Text="Alt" FontWeight="Bold" FontSize="11" Foreground="#00F0FF" /></Border>
                                    <TextBlock Text="+" Foreground="#8F9BA8" Margin="2, 4, 6, 0" />
                                    <Border Background="#252C3D" CornerRadius="6" Padding="8, 4" Margin="0, 0, 4, 0"><TextBlock Text="Shift" FontWeight="Bold" FontSize="11" Foreground="#00F0FF" /></Border>
                                    <TextBlock Text="+" Foreground="#8F9BA8" Margin="2, 4, 6, 0" />
                                    <Border Background="#252C3D" CornerRadius="6" Padding="8, 4"><TextBlock Text="T" FontWeight="Bold" FontSize="11" Foreground="#00F0FF" /></Border>
                                </StackPanel>
                                <TextBlock Text="Reorganizar todas las ventanas activas en mosaico BSP" FontSize="13" Foreground="#ECEFF4" HorizontalAlignment="Right" VerticalAlignment="Center" />
                            </Grid>
                            <Separator Background="#222838" Margin="0, 4" />

                            <!-- Item 3 -->
                            <Grid Margin="0, 6, 0, 10">
                                <StackPanel Orientation="Horizontal">
                                    <Border Background="#252C3D" CornerRadius="6" Padding="8, 4" Margin="0, 0, 4, 0"><TextBlock Text="Alt" FontWeight="Bold" FontSize="11" Foreground="#00F0FF" /></Border>
                                    <TextBlock Text="+" Foreground="#8F9BA8" Margin="2, 4, 6, 0" />
                                    <Border Background="#252C3D" CornerRadius="6" Padding="8, 4" Margin="0, 0, 4, 0"><TextBlock Text="Shift" FontWeight="Bold" FontSize="11" Foreground="#00F0FF" /></Border>
                                    <TextBlock Text="+" Foreground="#8F9BA8" Margin="2, 4, 6, 0" />
                                    <Border Background="#252C3D" CornerRadius="6" Padding="8, 4"><TextBlock Text="Q" FontWeight="Bold" FontSize="11" Foreground="#00F0FF" /></Border>
                                </StackPanel>
                                <TextBlock Text="Cerrar la ventana activa en foco de forma limpia (WM_CLOSE)" FontSize="13" Foreground="#ECEFF4" HorizontalAlignment="Right" VerticalAlignment="Center" />
                            </Grid>
                            <Separator Background="#222838" Margin="0, 4" />

                            <!-- Item 4 -->
                            <Grid Margin="0, 6, 0, 10">
                                <StackPanel Orientation="Horizontal">
                                    <Border Background="#252C3D" CornerRadius="6" Padding="8, 4" Margin="0, 0, 4, 0"><TextBlock Text="Alt" FontWeight="Bold" FontSize="11" Foreground="#00F0FF" /></Border>
                                    <TextBlock Text="+" Foreground="#8F9BA8" Margin="2, 4, 6, 0" />
                                    <Border Background="#252C3D" CornerRadius="6" Padding="8, 4" Margin="0, 0, 4, 0"><TextBlock Text="Shift" FontWeight="Bold" FontSize="11" Foreground="#00F0FF" /></Border>
                                    <TextBlock Text="+" Foreground="#8F9BA8" Margin="2, 4, 6, 0" />
                                    <Border Background="#252C3D" CornerRadius="6" Padding="8, 4"><TextBlock Text="H / L" FontWeight="Bold" FontSize="11" Foreground="#00F0FF" /></Border>
                                </StackPanel>
                                <TextBlock Text="Navegar foco a la ventana anterior o siguiente (Estilo Vim)" FontSize="13" Foreground="#ECEFF4" HorizontalAlignment="Right" VerticalAlignment="Center" />
                            </Grid>
                            <Separator Background="#222838" Margin="0, 4" />

                            <!-- Item 5 -->
                            <Grid Margin="0, 6, 0, 6">
                                <StackPanel Orientation="Horizontal">
                                    <Border Background="#252C3D" CornerRadius="6" Padding="8, 4" Margin="0, 0, 4, 0"><TextBlock Text="Alt" FontWeight="Bold" FontSize="11" Foreground="#00F0FF" /></Border>
                                    <TextBlock Text="+" Foreground="#8F9BA8" Margin="2, 4, 6, 0" />
                                    <Border Background="#252C3D" CornerRadius="6" Padding="8, 4" Margin="0, 0, 4, 0"><TextBlock Text="Shift" FontWeight="Bold" FontSize="11" Foreground="#00F0FF" /></Border>
                                    <TextBlock Text="+" Foreground="#8F9BA8" Margin="2, 4, 6, 0" />
                                    <Border Background="#252C3D" CornerRadius="6" Padding="8, 4"><TextBlock Text="Esc" FontWeight="Bold" FontSize="11" Foreground="#00F0FF" /></Border>
                                </StackPanel>
                                <TextBlock Text="Restaurar ventanas al tamaño original y salir del gestor" FontSize="13" Foreground="#ECEFF4" HorizontalAlignment="Right" VerticalAlignment="Center" />
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- TAB 4: WIDGETS -->
            <ScrollViewer x:Name="PanelWidgets" Grid.Row="0" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                <StackPanel>
                    <TextBlock Text="Widgets de Escritorio (Estilo Conky)" FontSize="20" FontWeight="Bold" Foreground="#FFFFFF" Margin="0, 0, 0, 4" />
                    <TextBlock Text="Controla los módulos translúcidos anclados al fondo de tu pantalla." FontSize="13" Foreground="#8F9BA8" Margin="0, 0, 0, 20" />

                    <Border Background="#181C26" CornerRadius="12" Padding="18" BorderBrush="#252A38" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="Reloj Digital y Monitor de Recursos" FontSize="16" FontWeight="SemiBold" Foreground="#FFFFFF" Margin="0, 0, 0, 4" />
                            <TextBlock Text="Muestra la fecha en español, hora digital y porcentaje de CPU y Memoria RAM en tiempo real." FontSize="13" Foreground="#8F9BA8" Margin="0, 0, 0, 16" />

                            <StackPanel Orientation="Horizontal">
                                <Button Content="🚀  Lanzar Widget en el Fondo" Click="BtnLaunchWidget_Click" Style="{StaticResource AccentButtonStyle}" Margin="0, 0, 12, 0" />
                                <Button Content="⏹️  Cerrar Widget" Click="BtnKillWidget_Click" Background="#2A2F3D" Foreground="#ECEFF4" Padding="14, 8" BorderThickness="0" Cursor="Hand" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- BOTTOM FOOTER ACTION BAR -->
            <Border Grid.Row="1" Margin="0, 16, 0, 0" Padding="0, 12, 0, 0" BorderBrush="#222838" BorderThickness="0, 1, 0, 0">
                <Grid>
                    <TextBlock x:Name="LblStatusMessage" Text="" FontSize="13" Foreground="#50FA7B" VerticalAlignment="Center" />
                    <Button Content="💾  Guardar y Aplicar Cambios" Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Right" Click="BtnSave_Click" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
