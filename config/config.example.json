{
  "InnerGap": 10,
  "OuterGap": 12,
  "AutoTileOnLaunch": true,
  "EnableBorderStyling": true,
  "ActiveBorderColor": "#00F0FF",
  "InactiveBorderColor": "#2E3440",
  "CornerPreference": "Square",
  "TerminalPath": "wt.exe",
  "IgnoredProcesses": [
    "Progman",
    "WorkerW",
    "Shell_TrayWnd",
    "Shell_SecondaryTrayWnd",
    "Taskmgr",
    "SnippingTool"
  ],
  "Keybindings": {
    "Alt+Shift+Enter": "SpawnTerminal",
    "Alt+Shift+T": "Retile",
    "Alt+Shift+Q": "CloseWindow",
    "Alt+Shift+H": "FocusLeft",
    "Alt+Shift+L": "FocusRight",
    "Alt+Shift+Escape": "Quit"
  }
}
